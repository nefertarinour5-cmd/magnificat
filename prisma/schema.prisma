// TeachHire RDC — Schema de base de données
// Plateforme professionnelle de mise en relation éducative

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// UTILISATEURS — Comptes avec authentification sécurisée
// ============================================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(PARENT)
  phone          String?
  whatsapp       String?
  avatarUrl      String?
  emailVerified  DateTime?
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  failedAttempts Int     @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent            Parent?
  teacher           Teacher?
  adminLogs         AdminLog[]
  sessions          Session[]
  notifications     Notification[]
  reviewedApplications Application[] @relation("ReviewedApplications")

  @@index([role])
  @@index([email])
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
}

// ============================================================
// SESSIONS — JWT-based, stockées en DB pour révocation
// ============================================================

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// ENSEIGNANTS — Profils publiés après validation admin
// ============================================================

model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  slug            String   @unique
  fullName        String
  age             Int?
  specialty       String
  level           String   // Primaire | Secondaire | Universitaire
  subject         String
  experienceYears Int
  city            String
  commune         String?
  phone           String
  whatsapp        String?
  hourlyRate      Int      // Crédits internes - géré par admin uniquement
  publicRate      Int?     // Tarif affiché publiquement (optionnel)
  availability    String   // En semaine | Week-end | Flexible
  bio             String
  methods         String   // JSON stringifié
  languages       String   // JSON stringifié
  rating          Float    @default(4.5)
  reviewsCount    Int      @default(0)
  isVerified      Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  isPublished     Boolean  @default(true)
  viewCount       Int      @default(0)
  internalCredits Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application?
  reviews     Review[]
  requests    Request[]
  favorites   Favorite[]

  @@index([city])
  @@index([subject])
  @@index([level])
  @@index([isPublished])
  @@index([isVerified])
}

// ============================================================
// CANDIDATURES — Dossiers en attente de validation
// ============================================================

model Application {
  id              String            @id @default(cuid())
  fullName        String
  email           String
  phone           String
  whatsapp        String?
  age             Int?
  specialty       String
  level           String
  subject         String
  experienceYears Int
  city            String
  commune         String?
  desiredRate     Int
  availability    String
  bio             String
  methods         String            @default("[]")
  languages       String            @default("[]")
  status          ApplicationStatus @default(PENDING)
  adminNote       String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  teacherId   String?  @unique
  reviewer    User?     @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  statusLogs  ApplicationStatusLog[]

  @@index([status])
  @@index([city])
  @@index([createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  INTERVIEW
}

model ApplicationStatusLog {
  id            String   @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  note          String?
  changedById   String?
  changedAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ============================================================
// PARENTS — Comptes familiaux
// ============================================================

model Parent {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  phone        String
  whatsapp     String?
  city         String
  address      String
  need         String?
  childrenInfo String?  // JSON: âge, niveau scolaire
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests  Request[]
  favorites Favorite[]
  reviews   Review[]

  @@index([city])
}

// ============================================================
// DEMANDES — Sollicitations parent -> enseignant
// ============================================================

model Request {
  id         String         @id @default(cuid())
  parentId   String
  teacherId  String
  message    String
  status     RequestStatus  @default(PENDING)
  priority   RequestPriority @default(NORMAL)
  adminNote  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
}

enum RequestStatus {
  PENDING
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
  ORIENTED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================================
// AVIS — Notes et commentaires sur enseignants
// ============================================================

model Review {
  id        String   @id @default(cuid())
  parentId  String
  teacherId String
  rating    Int      // 1-5
  comment   String?
  isApproved Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([parentId, teacherId])
  @@index([teacherId])
  @@index([isApproved])
}

// ============================================================
// FAVORIS — Enseignants favoris des parents
// ============================================================

model Favorite {
  id        String   @id @default(cuid())
  parentId  String
  teacherId String
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([parentId, teacherId])
}

// ============================================================
// NOTIFICATIONS — Alertes utilisateur
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================
// LOGS ADMIN — Audit trail
// ============================================================

model AdminLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================================
// PARAMÈTRES — Configuration globale
// ============================================================

model Setting {
  id    String @id
  value String
}
